{
  "name": "taskmaster-api",
  "version": "1.0.0",
  "description": "A simple Task Management REST API used as a Jenkins CI/CD learning project",
  "main": "src/app.js",
  "license": "MIT",
  "scripts": {
    "start": "node src/app.js",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "build": "node -e \"console.log('no bundling needed for a plain Node API')\"",
    "docker:build": "docker build -t taskmaster-api:latest .",
    "docker:run": "docker run -p 3000:3000 taskmaster-api:latest"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  }
}
